+void MtkBtFw::aclDone(void *owner, void *, IOReturn status, uint32_t bytes)
+{
+    MtkBtFw *me = (MtkBtFw *)owner;
+    me->aclBusy = false;
+    if (status == kIOReturnSuccess && bytes && bytes <= sizeof(me->aclFirst)) {
+        const uint8_t *p = (const uint8_t *)me->aclBuf->getBytesNoCopy();
+        if (p) { memcpy(me->aclFirst, p, bytes); me->aclLen = bytes; me->aclGot = true; }
+    }
+}
+
+void MtkBtFw::publishLe()
+{
+    OSNumber *n1 = OSNumber::withNumber((unsigned long long)leMetaCnt, 32);
+    OSNumber *n2 = OSNumber::withNumber((unsigned long long)leAdvReport, 32);
+    OSNumber *n3 = OSNumber::withNumber((unsigned long long)leSetTerm, 32);
+    if (n1) { setProperty("le-meta", n1); n1->release(); }
+    if (n2) { setProperty("le-adv-report", n2); n2->release(); }
+    if (n3) { setProperty("le-adv-set-term", n3); n3->release(); }
+}
