+        // connection first, which this controller cannot serve. Discovery over the AWDL service alone
+        // is what worked (the iPhone connected over TLS when advertising was off).
+        st = hciCmd(0x2039, en, sizeof(en), out, sizeof(out));            // LE Set Extended Advertising Enable
+        say("probe: LESetExtAdvEnable status=%d", st);
+        if (st == 0) {
+            say("adv: AirDrop beacon up for 3600 s, then the interface goes back to the Bluetooth stack");
+            IOSleep(3600000);
+            say("adv: hold over");
+        }
+    }
+    uint8_t par[15] = { 0xa0, 0x00, 0xa0, 0x00, 0x00, 0x00, 0x00, 0, 0, 0, 0, 0, 0, 0x07, 0x00 };
+    st = hciCmd(0x2006, par, sizeof(par), out, sizeof(out));
+    say("probe: LESetAdvParams status=%d", st);
+    uint8_t ad[31];
+    memset(ad, 0, sizeof(ad));
+    ad[0] = 0x1a; ad[1] = 0xff; ad[2] = 0x4c; ad[3] = 0x00; ad[4] = 0x05; ad[5] = 0x12; ad[6] = 0x40;
+    st = hciCmd(0x2008, ad, sizeof(ad), out, sizeof(out));
+    say("probe: LESetAdvData status=%d", st);
+    uint8_t en = 1;
+    st = hciCmd(0x200a, &en, 1, out, sizeof(out));
+    say("probe: LESetAdvEnable status=%d", st);
+}
