+// Ask the controller what it can do, before IOBluetoothFamily takes the interface over.
+void MtkBtFw::hciProbe()
+{
+    uint8_t out[48];
+    int st;
+    memset(out, 0, sizeof(out));
+    (void)0;
+#define PROBE_BEGIN() memset(out, 0, sizeof(out))
+
+    if (aclPipe && !aclBuf) {
+        aclBuf = IOBufferMemoryDescriptor::withCapacity(1024, kIODirectionIn);
+        if (aclBuf && aclBuf->prepare(kIODirectionIn) != kIOReturnSuccess) { aclBuf->release(); aclBuf = nullptr; }
+    }
+    if (aclPipe && aclBuf) {
+        IOUSBHostCompletion ac = { this, aclDone, nullptr };
+        aclGot = false; aclLen = 0; aclBusy = true;
+        if (aclPipe->io(aclBuf, 64, &ac, 0) != kIOReturnSuccess) aclBusy = false;
+    }
+    if (intrPipe) { intrPipe->clearStall(true); intrArm(); IOSleep(20); }   // the endpoint may be halted after the mode switch
+    if (cmdPipe) say("probe: HCI via OUT endpoint 0x%02x", cmdAddr);
+    else say("probe: HCI via control pipe (no OUT endpoint found)");
+    st = hciCmd(0x0c03, nullptr, 0, out, sizeof(out));          // HCI Reset: what the host sends first
+    say("probe: HCIReset status=%d", st);
+    IOSleep(50);
+    say("probe: bulkIN got=%u len=%u first=%02x%02x%02x%02x", aclGot ? 1u : 0u, (unsigned)aclLen,
+        aclFirst[0], aclFirst[1], aclFirst[2], aclFirst[3]);
+    st = hciCmd(0x1001, nullptr, 0, out, sizeof(out));
+    say("probe: ReadLocalVersion status=%d hci=%u lmp=%u manuf=%04x", st, st == 0 ? out[0] : 0,
+        st == 0 ? out[2] : 0, st == 0 ? (unsigned)(out[3] | (out[4] << 8)) : 0);
+    st = hciCmd(0x2002, nullptr, 0, out, sizeof(out));
+    say("probe: LEReadBufferSize status=%d size=%u pkts=%u", st, st == 0 ? out[0] : 0, st == 0 ? out[1] : 0);
+    st = hciCmd(0x2003, nullptr, 0, out, sizeof(out));
+    say("probe: LEReadFeatures status=%d %02x%02x%02x%02x%02x%02x%02x%02x", st,
+        out[0], out[1], out[2], out[3], out[4], out[5], out[6], out[7]);
+    st = hciCmd(0x2004, nullptr, 0, out, sizeof(out));                   // LE Read Supported States
+    say("probe: LEReadSupportedStates status=%d %02x%02x%02x%02x%02x%02x%02x%02x", st,
+        out[0], out[1], out[2], out[3], out[4], out[5], out[6], out[7]);
+    st = hciCmd(0x1003, nullptr, 0, out, sizeof(out));                   // HCI Read Local Supported Features
+    say("probe: ReadLocalFeatures status=%d %02x%02x%02x%02x%02x%02x%02x%02x", st,
+        out[0], out[1], out[2], out[3], out[4], out[5], out[6], out[7]);
+    st = hciCmd(0x203d, nullptr, 0, out, sizeof(out));
+    say("probe: LEReadNumAdvSets status=%d n=%u", st, st == 0 ? out[0] : 0);
+    // The controller answers "Command Disallowed" (0x0C) until the host has set the event masks.
+    {
+        uint8_t evmask[8] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+        st = hciCmd(0x0c01, evmask, 8, out, sizeof(out));                 // HCI Set Event Mask
+        say("probe: SetEventMask status=%d", st);
+        st = hciCmd(0x2001, evmask, 8, out, sizeof(out));                 // LE Set Event Mask
+        say("probe: LESetEventMask status=%d", st);
+        // and read the controller's own address, which advertising as "public" needs
+        uint8_t bd[6] = {0};
+        st = hciCmd(0x1009, nullptr, 0, out, sizeof(out));                // HCI Read BD_ADDR
+        say("probe: ReadBdAddr status=%d %02x:%02x:%02x:%02x:%02x:%02x", st, out[5], out[4], out[3], out[2], out[1], out[0]);
+        (void)bd;
+    }
+    {
+        uint8_t off = 0;
+        st = hciCmd(0x200a, &off, 1, out, sizeof(out));                   // LE Set Advertising Enable = 0 (clear any stale state)
+        say("probe: LESetAdvDisable status=%d", st);
+    }
+    // 15 bytes: interval min/max, type, own/peer addr type, peer addr[6], channel map, filter policy.
+    // The channel map must not be zero; it sits at index 13, not 12.
+    // Extended advertising path: some controllers reject the legacy commands outright.
+    {
+        PROBE_BEGIN();
+        {
+            // Apple devices advertise from a random address; iOS may ignore a public one.
+            uint8_t rnd[6] = { 0x12, 0x34, 0x56, 0x78, 0x9a, 0xc0 };   // top two bits 11 = static random
+            st = hciCmd(0x2005, rnd, sizeof(rnd), out, sizeof(out));   // LE Set Random Address
+            say("probe: LESetRandomAddr status=%d", st);
+        }
+        // bit4 of the properties = "use legacy PDU": the controller then sends ordinary ADV_* PDUs, which every
+        // scanner understands. bit0 connectable, bit1 scannable for that variant.
+        // 0x13 = use legacy PDU + connectable + scannable, which BLE-5 asks for.
+        uint8_t extPar[25] = { 0x00, 0x13, 0x00, 0xa0, 0x00, 0x00, 0xa0, 0x00, 0x00, 0x07,
+                               0x00, 0x00, 0, 0, 0, 0, 0, 0, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00 };
+        st = hciCmd(0x2036, extPar, sizeof(extPar), out, sizeof(out));   // LE Set Extended Advertising Parameters
+        say("probe: LESetExtAdvParams status=%d", st);
+        // AD structures: AirDrop manufacturer data (Apple 0x004C, TLV 0x05 0x12, 18-byte body) plus a local name
+        // so the beacon is identifiable in a scanner.
+        uint8_t ad[64];
+        uint32_t n = 0;
+        // Flags AD first: LE General Discoverable, BR/EDR not supported. Receivers commonly require it.
+        ad[n++] = 0x02; ad[n++] = 0x01; ad[n++] = 0x06;
+        ad[n++] = 0x17;                       // length: 1 type + 2 company + 2 TLV header + 18 payload = 23
+        ad[n++] = 0xff;                       // manufacturer specific data
+        ad[n++] = 0x4c; ad[n++] = 0x00;       // Apple
+        ad[n++] = 0x05; ad[n++] = 0x12;       // AirDrop TLV
+        // 18-byte AirDrop TLV payload, version 3 (owly SPEC BLE-2): 0x40, 3-byte tag, 4 reserved zero,
+        // version 0x03, four 2-byte contact hashes (zero here: Everyone mode), one reserved zero.
+        ad[n++] = 0x40;
+        ad[n++] = 0xaa; ad[n++] = 0xbb; ad[n++] = 0xcc;   // tag
+        ad[n++] = 0x00; ad[n++] = 0x00; ad[n++] = 0x00; ad[n++] = 0x00;
+        ad[n++] = 0x03;                                   // version 3
+        for (int i = 0; i < 8; i++) ad[n++] = 0x00;       // contact hashes: none (Everyone mode wakes)
+        ad[n++] = 0x00;
+        // Legacy PDUs carry at most 31 bytes: 3 (flags) + 24 (manufacturer) + 3 (one-letter name) = 30.
+        ad[n++] = 0x02; ad[n++] = 0x09; ad[n++] = 'M';   // complete local name, one letter
+        uint8_t extData[80];
+        memset(extData, 0, sizeof(extData));
+        extData[0] = 0x00;      // advertising handle
+        extData[1] = 0x03;      // operation: complete data
+        extData[2] = 0x00;      // fragment preference
+        extData[3] = (uint8_t)n;
+        memcpy(extData + 4, ad, n);
+        {
+            char hex[3 * 40 + 1] = {0};
+            uint32_t m = n < 40 ? n : 40;
+            for (uint32_t i = 0; i < m; i++) snprintf(hex + 3 * i, 4, "%02x ", ad[i]);
+            say("adv: AD len=%u: %s", (unsigned)n, hex);
+        }
+        st = hciCmd(0x2037, extData, 4 + n, out, sizeof(out));           // LE Set Extended Advertising Data
+        say("probe: LESetExtAdvData status=%d", st);
+        // enable(1) + num_sets(1) + [handle(1) + duration(2) + max_events(1)] = 6 bytes
+        uint8_t en[6] = { 0x01, 0x01, 0x00, 0x00, 0x00, 0x00 };
