+                // class request 0x20) before macOS's own transport opens the device. Fire and forget: no event wait.
+                {
+                    uint8_t b[3] = { 0x03, 0x0c, 0x00 };            // HCI Reset, no packet-type byte
+                    IOReturn pr = ctrl(0x20, 0x00, 0, 0, b, 3, nullptr);
+                    say("prime: HCI Reset on control endpoint -> %08x", (unsigned)pr);
+                }
+                IOSleep(200);
+                hciProbe();                    // let the controller settle before IOBluetoothFamily opens the interface
+                ok = true;
+                break;
+            }
         }
         say("attempt %u failed after %llu ms, %u interrupt packets so far", attempt, nowMs() - ta, intrPackets);
     }
