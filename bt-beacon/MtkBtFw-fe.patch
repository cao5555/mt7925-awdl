 // HCI Read Local Version Information (0x1001) on the normal HCI path: command on the control endpoint, Command Complete on the
 // interrupt endpoint. Answered only when the RAM code is running.
+// One HCI command through the control endpoint, waiting for its command-complete event on the interrupt pipe.
+// Returns the HCI status byte, -1 on timeout, -2 when the transfer failed. `out` gets the event parameters after the status.
+int MtkBtFw::hciCmd(uint16_t opcode, const uint8_t *params, uint8_t plen, uint8_t *out, uint32_t outCap)
+{
+    if (!intrPipe || !cmd) return -2;
+    cmd[0] = 0x01;
+    cmd[1] = (uint8_t)(opcode & 0xff);
+    cmd[2] = (uint8_t)(opcode >> 8);
+    cmd[3] = plen;
+    if (plen) memcpy(cmd + 4, params, plen);
+    hciGot = false;
+    hciEvLen = 0;
+    hciWaitOpcode = opcode;
+    hciWait = true;
+    // MediaTek parts take HCI commands on the control endpoint WITHOUT the packet-type byte: with it the chip answers
+    // with a bogus "Command Status" for opcode 0x0101, without it the Command Complete carries our opcode.
+    IOReturn r = ctrl(0x20, 0x00, 0, 0, cmd + 1, (uint16_t)(3 + plen), nullptr);
+    if (r != kIOReturnSuccess) { hciWait = false; return -2; }
+    for (int i = 0; i < 300 && !hciGot; i++) IOSleep(5);
+    hciWait = false;
+    if (!hciGot) return -1;
+    uint32_t status = hciEvLen > 5 ? hciEv[5] : 0xff;
+    if (out && outCap && hciEvLen > 6) {
+        uint32_t n = hciEvLen - 6;
+        if (n > outCap) n = outCap;
+        memcpy(out, hciEv + 6, n);
+    }
+    return (int)status;
+}
