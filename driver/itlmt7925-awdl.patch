+// ---------------------------------------------------------------------------------------------
+
+// ---------------------------------------------------------------------------------------------
+// BSS_INFO_UPDATE for the AWDL link (bss_idx 1, CONNECTION_IBSS_ADHOC, OMAC 1).
+// The peer station record alone did nothing: a wcid is only usable inside a BSS context, and the
+// driver only ever created the infrastructure one. Without this the hardware drops every data
+// frame addressed to a peer (awdl txfree: uc=0/N, no ACK, the sender stalls and retransmits).
+// ---------------------------------------------------------------------------------------------
+int itlmt7925::m3AwdlBssAdd()
+{
+    uint8_t bss[4 + 32];
+    bzero(bss, sizeof(bss));
+    bss[0] = 1;                                              // bss_idx 1 (0 is the infrastructure BSS)
+    uint8_t *b = bss + 4;
+    put16(b + 0, 0);                                         // tag UNI_BSS_INFO_BASIC
+    put16(b + 2, 32);                                        // len
+    b[4] = 1;                                                // active
+    b[5] = 1;                                                // omac_idx: the AWDL address (awdlOwnMacApply)
+    b[6] = 1;                                                // hw_bss_idx
+    b[7] = 0xff;                                             // band_idx auto
+    put32(b + 8, 0x40004);                                   // CONNECTION_IBSS_ADHOC
+    b[12] = 1;                                               // conn_state
+    b[13] = 0;                                               // wmm_idx
+    put16(b + 20, 19);                                       // bmc_tx_wlan_idx (WTBL_RESERVED)
+    put16(b + 26, 19);                                       // sta_idx
+    b[31] = 0;                                               // link_idx
+    int rc = m3Cmd(UNI_BSS_INFO_UPDATE, bss, sizeof(bss), "awdl bss_info(ibss)");
+    m3log("awdl bss_info bss_idx=1 ibss rc=%d", rc);
+    return rc;
+}
+
+// STA_REC_UPDATE for an AWDL peer (mt7925_mcu_sta_cmd, CONNECTION_IBSS_ADHOC).
+// Without a record of its own the hardware never acknowledges the peer's unicast frames and the
+// sender retransmits everything, so a transfer crawls or stalls (awdl txfree: uc=2/27).
+// ---------------------------------------------------------------------------------------------
+int itlmt7925::m3AwdlPeerAdd(const uint8_t *peer, uint8_t wcid)
+{
+    M3Msg m;
+    m.init(8);
+    m.b[0] = M3_BSS_IDX;
+    m.b[1] = wcid;                                           // wlan_idx_lo
+    m.b[4] = 1;                                              // is_tlv_append
+    m.b[5] = 1;                                              // muar_idx: the AWDL OMAC programmed by awdlOwnMacApply
+    m.b[6] = 0;
+
+    uint8_t *b = m.tlv(0, 20);                               // STA_REC_BASIC
+    put32(b + 4, 0x40004);                                   // CONNECTION_IBSS_ADHOC (STA_TYPE_ADHOC | NETWORK_IBSS)
+    b[8] = 2;                                                // CONN_STATE_PORT_SECURE
+    b[9] = 1;                                                // qos
+    put16(b + 10, 0);                                        // aid
+    memcpy(b + 12, peer, 6);
+    put16(b + 18, 3);                                        // EXTRA_INFO_VER | EXTRA_INFO_NEW
+
+    // The rate set has to match the channel the frame goes out on: channels 6/44 are 2.4 GHz/5 GHz mixed use but the
+    // AWDL social channel is usually 149, where only OFDM rates exist.
+    bool g2ch = awdlRocCh && awdlRocCh <= 14;
+    uint8_t *p = m.tlv(0x15, 12);                            // STA_REC_PHY
+    put16(p + 4, g2ch ? (uint16_t)0x0fff : (uint16_t)(0x0fff & ~0x000f));   // basic_rate
+    p[6] = g2ch ? 0x03 : (1u << 3);                          // HR_DSSS | ERP, else OFDM
+
+    uint8_t *ra = m.tlv(1, 16);                              // STA_REC_RA
+    put16(ra + 4, g2ch ? (uint16_t)0x0fff : (uint16_t)((0x0fff & ~0x000f)));   // RA_LEGACY
+
+    uint8_t *st = m.tlv(7, 16);                              // STA_REC_STATE
+    st[4] = 2;                                               // STA_STATE_ASSOC
+
+    uint8_t *h = m.tlv(0x2b, 8);                             // STA_REC_HDR_TRANS
+    h[4] = 0; h[5] = 0;                                      // no DS bits: AWDL data frames are IBSS style
+    h[6] = 1;                                                // dis_rx_hdr_tran
+
+    char nm[40];
+    snprintf(nm, sizeof(nm), "awdl sta_rec wcid=%u", wcid);
+    int rc = m3Cmd(UNI_STA_REC_UPDATE, m.b, m.n, nm);
+    m3log("awdl sta_rec %02x:%02x:%02x:%02x:%02x:%02x wcid=%u rc=%d", peer[0], peer[1], peer[2], peer[3], peer[4], peer[5],
+          wcid, rc);
+    return rc;
+}
